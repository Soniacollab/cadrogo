# Clé API LLM (obligatoire pour /api/analyze)
# - OpenAI : sk-...
# - Groq   : gsk-...  (détecté automatiquement)
OPENAI_API_KEY=gsk_...

# Optionnel
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Code d'accès beta (si défini, obligatoire pour /api/analyze)
# CADROGO_ACCESS_CODE=votre-code-secret

# Quotas anti-abus (best-effort, mémoire instance)
# ANALYZE_LIMIT_PER_IP_HOUR=3
# ANALYZE_LIMIT_PER_IP_DAY=8
# ANALYZE_LIMIT_GLOBAL_DAY=40
